<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Matches where UpdateChecker.kt writes the downloaded update APK
         (context.getExternalFilesDir(null)) - app-private, no storage
         permission needed on modern Android. -->
    <external-files-path name="updates" path="." />
    <!-- The log export FileLog.exportForShare writes for the Лог screen's
         "Поделиться" (context.cacheDir/logs) - shared as an attachment, since
         a day of log is far past what fits in share-intent text. -->
    <cache-path name="logs" path="logs/" />
</paths>
